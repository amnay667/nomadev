{
  "name": "argus-camera-fx",
  "version": "1.0.0",
  "description": "Real-time, fully client-side computer-vision camera engine: GLSL shader effects pipeline + on-device face mesh and hand tracking with particle overlays.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e:fixture": "node test/generate-fake-camera.mjs test/fixtures/fake-cam.y4m",
    "test:e2e": "node test/e2e.mjs test/fixtures/fake-cam.y4m"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.17"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
